# الگو برای فایل .env — این فایل را کپی کنید و مقادیر واقعی را وارد نمایید:
#   cp .env.example .env
#
# فایل .env هرگز نباید کامیت شود.

# با این دستور یک کلید تصادفی امن بسازید:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# در production همیشه False
DJANGO_DEBUG=True

# در production، دامنه(های) واقعی سرویس را با کاما جدا کنید
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# کلید API سامانه پیامکی دیگر اینجا تنظیم نمی‌شود — بعد از اجرای مهاجرت‌ها
# و بالا آمدن سرور، از /staff/settings/sms/ در داشبورد ادمین وارد کنید.

# اختیاری: آدرس Redis برای کش (مثل redis://127.0.0.1:6379/1). اگر خالی
# بماند، از کش حافظه محلی (LocMemCache) استفاده می‌شود — برای توسعه کافی
# است، اما بین چند worker/سرور مشترک نیست.
REDIS_URL=

# اختیاری: broker پیام برای Celery (پردازش ناهمزمان). بدون این مقدار،
# Celery در حالت eager اجرا می‌شود (همزمان، بدون نیاز به worker/broker
# جداگانه) — برای production یک broker واقعی (مثلاً همان Redis) لازم است.
CELERY_BROKER_URL=
